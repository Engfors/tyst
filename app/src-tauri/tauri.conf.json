{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tyst",
  "mainBinaryName": "tyst",
  "identifier": "com.engfors.tyst",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "appimage"],
    "category": "Productivity",
    "resources": {
      "../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../../LICENSE-MIT": "LICENSE-MIT",
      "../../LICENSE-APACHE": "LICENSE-APACHE"
    },
    "shortDescription": "Local meeting transcription",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "macOS": {
      "minimumSystemVersion": "14.4",
      "infoPlist": "Info.plist"
    },
    "linux": {
      "appimage": { "bundleMediaFramework": false },
      "deb": { "desktopTemplate": "../../packaging/linux/tyst.desktop" }
    }
  }
}
