{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "onboarding",
  "description": "First-run setup: folders, models, a microphone test and desktop permissions.",
  "windows": [
    "onboarding"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "allow-audio-test",
    "allow-config-get",
    "allow-config-set",
    "allow-dictation-info",
    "allow-dictation-setup-keyboard",
    "allow-dictation-setup-shortcuts",
    "allow-models-cancel",
    "allow-models-fetch",
    "allow-models-status",
    "allow-models-verify",
    "allow-onboarding-finish",
    "allow-pick-folder"
  ]
}
