<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The bundle is signed with the hardened runtime, which denies the microphone without this
       entitlement: macOS never asks and Tyst never shows up under Privacy & Security › Microphone. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
